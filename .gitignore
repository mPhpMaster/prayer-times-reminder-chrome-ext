# ---- Packaged extension artifacts ----
*.crx
*.pem
*.zip
dist/
build/
web-ext-artifacts/

# ---- sync-core generated target outputs (assembled from core/ + targets/<t>/) ----
targets/extension/build/
targets/desktop/src/
targets/mobile/www/

# ---- Store-screenshot transient harness (written by make_store_screenshots.py) ----
_store_harness.html

# ---- Local test profile (created by the --user-data-dir launch) ----
chrome-ext-testprofile/
*-testprofile/

# ---- Node (if tooling is ever added) ----
.version-backup
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Python (icon generation) ----
__pycache__/
*.py[cod]
.venv/
venv/

# ---- Editors / IDEs ----
.vscode/
.idea/
*.swp
*~

# ---- OS cruft ----
.DS_Store
Thumbs.db
Desktop.ini

# ---- Logs / env ----
*.log
.env
.env.local

# ---- Tauri / Rust build artifacts ----
targets/desktop/src-tauri/target/
targets/desktop/src-tauri/gen/
# Cargo.lock IS tracked (this is an app): it pins time=0.3.51 to dodge the
# cookie 0.18.1 vs time 0.3.52 breakage in the tauri 2.11 graph.

# ---- Capacitor / Android build artifacts ----
# (the native source under targets/mobile/android/ IS tracked; Capacitor's own
#  android/.gitignore covers build outputs like .gradle/, app/build/, etc.)
targets/mobile/www/
targets/mobile/node_modules/
targets/mobile/android/.gradle/
targets/mobile/android/build/
targets/mobile/android/app/build/
targets/mobile/android/capacitor-cordova-android-plugins/
targets/mobile/android/local.properties

# ---- Local agent + tooling ----
.claude/
pnpm-lock.yaml

# ---- Signing material — NEVER commit (keystores, archives) ----
*.rar
*.jks
*.keystore

# ---- Desktop MSIX packaging build outputs (the .exe copy + packed .msix) ----
targets/desktop/msix/*.msix
targets/desktop/msix/layout/*.exe

# Build releases and packaged runtimes
store-release/
**/WebView2Runtime/
*.msix
# ---- GeoNames downloads for tools/build-city-names.mjs ----
tools/.cache/
