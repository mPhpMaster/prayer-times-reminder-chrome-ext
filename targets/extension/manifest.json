{
    "manifest_version": 3,
    "default_locale": "en",
    "name": "__MSG_appName__",
    "short_name": "__MSG_appShortName__",
    "version": "2.3.0",
    "description": "__MSG_appDesc__",
    "minimum_chrome_version": "111",
    "permissions": ["alarms", "notifications", "storage", "geolocation", "scripting", "offscreen", "identity"],
    "optional_host_permissions": ["<all_urls>"],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "__MSG_appName__",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}