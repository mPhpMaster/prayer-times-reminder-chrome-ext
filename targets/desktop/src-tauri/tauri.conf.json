{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prayer",
  "version": "0.1.0",
  "identifier": "com.example.prayer",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "node ../../tools/sync-core.mjs desktop",
    "beforeBuildCommand": "node ../../tools/sync-core.mjs desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "settings",
        "title": "Prayer",
        "url": "popup.html",
        "width": 360,
        "height": 600,
        "resizable": false,
        "decorations": false,
        "shadow": true,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "background",
        "url": "scheduler.html",
        "visible": false,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  }
}
