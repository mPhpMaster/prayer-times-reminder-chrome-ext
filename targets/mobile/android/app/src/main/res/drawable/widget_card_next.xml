<?xml version="1.0" encoding="utf-8"?>
<!-- The countdown widget: the popup's .next-card (gradient + accent border). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="@color/widget_next_end"
        android:startColor="@color/widget_next_start" />
    <stroke android:width="1dp" android:color="@color/widget_next_stroke" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
